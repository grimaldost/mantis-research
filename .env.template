# Copy to .env (which is gitignored). Required for the OpenRouter stage.

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# OpenRouter API root. Override only to point at a proxy or a mock.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers (used by OpenRouter for usage leaderboards)
MANTIS_HTTP_REFERER=https://github.com/grimaldost/mantis-research
MANTIS_APP_TITLE=mantis-research

# Interface gating — comma-separated stage names refused at CLI dispatch.
# Useful for declaring which provider CLIs / subscriptions are unavailable
# on this machine so attempts to invoke them fail fast with a helpful error.
#
# Valid names: claude, gemini, openrouter, synthesis, journal-passes,
# falsification, evaluation, claude-prior. Common usage: set this to
# `gemini` when adopting Path B from
# prompts/playbooks/research-path-recommendation.md (no Gemini CLI
# subscription on this machine; use Gemini-via-OpenRouter instead).
#
# Example: DISABLED_STAGES=gemini
DISABLED_STAGES=

# Data root — where runs write outputs/, state/, logs/ and transcripts/, and
# where the seat lock lives. Unset (the default): a clone uses its own root, a
# plugin run from Claude Code's plugin cache uses ~/.mantis, and an installed
# tool uses the current working directory. `~` is expanded.
#
# Example: MANTIS_HOME=~/mantis-data
# MANTIS_HOME=
